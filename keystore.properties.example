# Copy to keystore.properties and fill in. keystore.properties is gitignored.
#
# Create the keystore with:
#   keytool -genkeypair -v -keystore keystore/hplay-release.jks \
#     -alias hplay -keyalg RSA -keysize 2048 -validity 10950 \
#     -storepass <password> -keypass <password> -dname "CN=Hplay, O=Hplay, C=CN"
storeFile=keystore/hplay-release.jks
storePassword=
keyAlias=hplay
keyPassword=
