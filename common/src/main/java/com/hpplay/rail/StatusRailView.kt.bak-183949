        stepper.addView(plus, LinearLayout.LayoutParams(d(80), d(80)).apply { marginStart = d(22) })
        col.addView(stepper)

        val chips = LinearLayout(context).apply { orientation = HORIZONTAL; gravity = Gravity.CENTER }
        chipAuto = panelChip("AUTO") { toggleAuto() }
