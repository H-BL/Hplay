        val stepper = LinearLayout(context).apply { orientation = HORIZONTAL; gravity = Gravity.CENTER }
        stepper.addView(stepButton("−") { adjustTemperature(-0.5) })
        val plus = stepButton("+") { adjustTemperature(+0.5) }
