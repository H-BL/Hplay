        chips.addView(chipAuto)
        chips.addView(chipRecirc, LinearLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT).apply { marginStart = d(8) })
        chips.addView(chipAc, LinearLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT).apply { marginStart = d(8) })
        col.addView(chips, LinearLayout.LayoutParams(WRAP_CONTENT, WRAP_CONTENT).apply { topMargin = d(14) })
        return col
    }

    private fun seatColumn(): View {
        val col = LinearLayout(context).apply { orientation = VERTICAL }
        col.addView(panelLabel("座椅加热 / 通风"))
        val grid = LinearLayout(context).apply { orientation = VERTICAL }
        val seats = listOf("driver" to "主驾", "passenger" to "副驾", "rearLeft" to "左后", "rearRight" to "右后")
        seats.chunked(2).forEach { pair ->
            val row = LinearLayout(context).apply { orientation = HORIZONTAL }
            pair.forEach { (key, label) ->
                val text = TextView(context).apply {
                    text = "$label · --"
                    textSize = sf(17f)
