<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- API 31+ : also pin the splash screen background, otherwise it falls back
         to the light parent theme and flashes white on cold start. -->
    <style name="Theme.Hplay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/hplay_background</item>
        <item name="android:windowSplashScreenBackground">@color/hplay_background</item>
    </style>

</resources>
